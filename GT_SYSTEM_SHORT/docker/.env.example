# Copy this file to `.env` (same directory) and fill in your values.
# NEVER commit `.env` to git — it contains your IBKR password.
#
#   cp .env.example .env
#   # then edit .env in your editor
#
# After editing, start the gateway:
#   docker compose up -d
#
# To check it's running:
#   docker compose ps
#   docker compose logs -f ib-gateway

# Your IBKR paper account username (case-sensitive)
TWS_USERID=

# Your IBKR paper account password
TWS_PASSWORD=

# paper | live — leave as paper unless you mean it
TRADING_MODE=paper

# Optional VNC password if you ever need to debug visually
# Bound to 127.0.0.1:5900 only — never exposed to the internet
VNC_SERVER_PASSWORD=changeme

# IBKR session timezone — set to where you want the daily reset to occur
TIME_ZONE=America/New_York
